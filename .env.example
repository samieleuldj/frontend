# Frontend Environment Variables (EasyPanel → frontend → Environment)
NEXT_PUBLIC_SITE_URL=https://confortdz.shop
NEXT_PUBLIC_API_URL=https://api.confortdz.shop
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_verification_code

# Meta / TikTok / Snap pixels (browser tracking)
# Meta: Events Manager → Data Sources → Pixel → copy Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=your_meta_pixel_id
NEXT_PUBLIC_TIKTOK_PIXEL_ID=your_tiktok_pixel_id
NEXT_PUBLIC_SNAP_PIXEL_ID=your_snap_pixel_id
